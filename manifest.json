{
  "manifest_version": 3,
  "name": "Goofish EN — перевод и цены в ₽/$",
  "short_name": "Goofish EN",
  "version": "1.7.1",
  "description": "Мгновенный перевод Goofish (闲鱼) на английский, цены в ₽/$, расчёт через байера, избранное-корзина и блокировка окон входа.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://clients5.google.com/*",
    "https://open.er-api.com/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://goofish.com/*", "*://*.goofish.com/*"],
      "js": ["dict.js", "shared.js", "content.js", "favpanel.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Goofish EN",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
